# ---------------------------------------------------------------------------
# Model: bring your own key. Set one provider key, and optionally the model.
# Any provider Hermes supports works: https://hermes-agent.nousresearch.com/docs
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# HERMES_PROVIDER=anthropic          # optional: openrouter, anthropic, gemini, custom, ...
# HERMES_MODEL=claude-sonnet-4-6     # optional
# HERMES_BASE_URL=                   # optional: any OpenAI-compatible endpoint (vLLM, Ollama, LiteLLM)

# ---------------------------------------------------------------------------
# Where people talk to the agent (pick one or more; see Hermes' messaging docs)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=            # your Telegram user id(s)
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Hibira Approvals: who approves changes.
# Either run `docker compose exec agent mcp-approval-gate login` once,
# or paste a workspace token here (Approvals > Settings > Gates).
# ---------------------------------------------------------------------------
# HIBIRA_APPROVALS_TOKEN=
# GATE_APPROVERS=sre                 # optional: approver group slugs or emails
# HIBIRA_TERMINAL_APPROVALS=on       # off turns the terminal hook off (not recommended)

# ---------------------------------------------------------------------------
# Modules: each one turns on when its settings are present.
# Use credentials scoped to what you want the agent to see and change.
# ---------------------------------------------------------------------------
# Cloudflare (wrangler + API)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# AWS (aws CLI). Or mount ~/.aws into ./data/.aws and set AWS_PROFILE.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Google Cloud (gcloud). The service account key JSON on one line,
# or mount the file and set GOOGLE_APPLICATION_CREDENTIALS to its path.
# GCP_SERVICE_ACCOUNT_JSON=
# CLOUDSDK_CORE_PROJECT=

# Grafana (also Loki, Tempo, alerting, incidents through Grafana)
# GRAFANA_URL=https://grafana.example.com
# GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Prometheus
# PROMETHEUS_URL=http://prometheus:9090

# Elasticsearch
# ES_URL=https://es.example.com:9200
# ES_API_KEY=

# Kibana Agent Builder (Elastic 9.2+)
# KIBANA_URL=https://kibana.example.com
# KIBANA_API_KEY=

# A database: Postgres, MySQL, MariaDB, SQL Server or SQLite. Reads run, writes wait.
# DATABASE_URL=postgres://readonly:secret@db:5432/app?sslmode=require
# DATABASE_LABEL=Production DB
